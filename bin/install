#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

from config_contract import ContractError, load_contract, require_projection

ROOT = Path(__file__).resolve().parent.parent
MANAGED_MARKER = "# omp-config managed review gate v1"
LEGACY_MANAGED_MARKER = "# omp-review-gate: managed by omp-config"
LEGACY_FOREIGN_HOOK_NAME = "pre-push.omp-foreign"
FOREIGN_HOOK_NAME = "pre-push.omp-config-foreign"


def die(message: str) -> None:
    print(f"install: {message}", file=sys.stderr)
    raise SystemExit(1)


def _active_hooks_path(project: Path) -> Path:
    project = project.expanduser().resolve()
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--git-path", "hooks"],
            cwd=project,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except OSError as error:
        die(f"cannot inspect Git hooks path for {project}: {error}")
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip()
        die(f"cannot inspect Git hooks path for {project}: {detail}")
    raw_path = result.stdout.strip()
    if not raw_path:
        die(f"Git reported an empty hooks path for {project}")
    hooks = Path(raw_path).expanduser()
    if not hooks.is_absolute():
        hooks = project / hooks
    return hooks.resolve(strict=False)


def _managed_hook_content(agent_dir: Path) -> bytes:
    gate = (agent_dir.expanduser() / "hooks" / "review-gate.py").resolve(strict=False)
    return (
        "#!/bin/sh\n"
        f"{MANAGED_MARKER}\n"
        "set -eu\n"
        'if ! repo_root=$(git rev-parse --show-toplevel 2>/dev/null); then\n'
        '  echo "review gate unavailable: cannot resolve the Git worktree" >&2\n'
        "  exit 1\n"
        "fi\n"
        'hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)\n'
        'input_file=$(mktemp "${TMPDIR:-/tmp}/omp-review-gate.XXXXXX")\n'
        'cleanup() { rm -f "$input_file"; }\n'
        "trap cleanup EXIT HUP INT TERM\n"
        'cat >"$input_file"\n'
        f'foreign="$hook_dir/{FOREIGN_HOOK_NAME}"\n'
        'if [ -e "$foreign" ] || [ -L "$foreign" ]; then\n'
        '  if [ -f "$foreign" ] && [ -x "$foreign" ]; then\n'
        '    if "$foreign" "$@" <"$input_file"; then\n'
        "      :\n"
        "    else\n"
        "      status=$?\n"
        '      exit "$status"\n'
        "    fi\n"
        "  else\n"
        '    echo "review gate warning: skipping non-executable foreign hook $foreign" >&2\n'
        "  fi\n"
        "fi\n"
        f"if python3 {shlex.quote(str(gate))} hook --repo \"$repo_root\" --remote \"${{1-}}\" <\"$input_file\"; then\n"
        "  status=0\n"
        "else\n"
        "  status=$?\n"
        "fi\n"
        "exit \"$status\"\n"
    ).encode("utf-8")


def _contains_marker(path: Path, marker: str) -> bool:
    try:
        return marker.encode("utf-8") in path.read_bytes()
    except OSError:
        return False


def _is_managed_hook(path: Path) -> bool:
    return _contains_marker(path, MANAGED_MARKER) or _contains_marker(path, LEGACY_MANAGED_MARKER)


def _write_managed_hook(path: Path, content: bytes) -> None:
    temporary_path: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="wb",
            prefix=f".{path.name}.",
            dir=path.parent,
            delete=False,
        ) as temporary:
            temporary.write(content)
            temporary.flush()
            os.fchmod(temporary.fileno(), 0o755)
            temporary_path = Path(temporary.name)
        os.replace(temporary_path, path)
    finally:
        if temporary_path is not None:
            temporary_path.unlink(missing_ok=True)


def install_review_hook(project: Path, agent_dir: Path) -> Path:
    hooks = _active_hooks_path(project)
    hooks.mkdir(parents=True, exist_ok=True)
    hook = hooks / "pre-push"
    foreign = hooks / FOREIGN_HOOK_NAME
    legacy_managed = _contains_marker(hook, LEGACY_MANAGED_MARKER)
    if (hook.exists() or hook.is_symlink()) and not _is_managed_hook(hook):
        if foreign.exists() or foreign.is_symlink():
            die(f"foreign hook backup already exists at {foreign}")
        shutil.move(str(hook), str(foreign))
        print(f"backup foreign hook: {hook} -> {foreign}")
    if legacy_managed:
        legacy_foreign = hooks / LEGACY_FOREIGN_HOOK_NAME
        if (
            (foreign.exists() or foreign.is_symlink())
            and not _contains_marker(foreign, LEGACY_MANAGED_MARKER)
            and legacy_foreign.is_file()
            and not legacy_foreign.is_symlink()
        ):
            die(
                "ambiguous legacy hook migration: both "
                f"{foreign} and {legacy_foreign} contain foreign hook state"
            )
        if _contains_marker(foreign, LEGACY_MANAGED_MARKER):
            if legacy_foreign.is_file() and not legacy_foreign.is_symlink():
                shutil.copy2(legacy_foreign, foreign)
                print(f"migrate legacy foreign hook: {legacy_foreign} -> {foreign}")
            else:
                foreign.unlink()
        elif not (foreign.exists() or foreign.is_symlink()) and legacy_foreign.is_file() and not legacy_foreign.is_symlink():
            shutil.copy2(legacy_foreign, foreign)
            print(f"migrate legacy foreign hook: {legacy_foreign} -> {foreign}")
    _write_managed_hook(hook, _managed_hook_content(agent_dir))
    gate = (agent_dir.expanduser() / "hooks" / "review-gate.py").resolve(strict=False)
    print(f"install review hook: {hook} -> {gate}")
    return hook


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="install the declarative OMP projection")
    parser.add_argument(
        "--project",
        type=Path,
        help="Git project whose active pre-push hook should run the review gate",
    )
    args = parser.parse_args(argv)
    try:
        contract = load_contract(ROOT)
    except ContractError as error:
        die(str(error))
    agent_dir = contract.projection_root
    agent_dir.mkdir(parents=True, exist_ok=True)

    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    backup = agent_dir / "backups" / f"omp-config-{stamp}"
    backed_up = False

    for surface in contract.surfaces:
        source = surface.source
        target = surface.target
        if target.is_symlink() and target.resolve(strict=False) == source.resolve():
            print(f"keep {target} -> {source}")
            continue
        if target.exists() or target.is_symlink():
            destination = backup / surface.target_rel
            destination.parent.mkdir(parents=True, exist_ok=True)
            if destination.exists() or destination.is_symlink():
                die(f"backup collision at {destination}")
            shutil.move(str(target), str(destination))
            backed_up = True
            print(f"backup {target} -> {destination}")
        target.parent.mkdir(parents=True, exist_ok=True)
        target.symlink_to(source, target_is_directory=surface.kind == "directory")
        print(f"link {target} -> {source}")

    local_env = agent_dir / ".env"
    if local_env.exists():
        os.chmod(local_env, 0o600)

    try:
        receipts = require_projection(contract)
        if args.project is not None:
            install_review_hook(args.project, agent_dir)
    except (ContractError, OSError) as error:
        die(f"installation verification failed: {error}")
    if backed_up:
        print(f"backup root: {backup}")
    print(
        "OMP declarative configuration installed; "
        f"{len(receipts)} symlinks and digests verified; mutable runtime state untouched"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
