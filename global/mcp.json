{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "parallel-search": {
      "type": "http",
      "url": "https://search.parallel.ai/mcp"
    },
    "exa-mint": {
      "type": "stdio",
      "command": "${HOME}/.omp/agent/skills/research/scripts/exa_mcp_stdio.py",
      "timeout": 120000
    },
    "firecrawl-mint": {
      "type": "stdio",
      "command": "${HOME}/.omp/agent/skills/research/scripts/firecrawl_mcp_stdio.py",
      "timeout": 180000
    }
  },
  "disabledServers": [
    "canary",
    "chrome-devtools",
    "computer-use",
    "crucible",
    "monologue",
    "node_repl",
    "openaiDeveloperDocs",
    "openrouter",
    "overmind",
    "powder",
    "pencil",
    "qmd"
  ]
}
