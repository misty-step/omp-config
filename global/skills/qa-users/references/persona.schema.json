{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://misty-step.dev/schemas/qa-users/persona.v1.json",
  "title": "qa-users persona",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "label",
    "mission",
    "entrypoint_ids",
    "source_read",
    "tracker_read",
    "issue_write"
  ],
  "properties": {
    "schema_version": { "const": "qa-users.persona.v1" },
    "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z][a-z0-9._-]{1,63}$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 128 },
    "mission": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "strength_focus": { "type": "string", "maxLength": 512 },
    "friction_focus": { "type": "string", "maxLength": 512 },
    "entrypoint_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9._-]{1,63}$" }
    },
    "source_read": { "const": false },
    "tracker_read": { "const": false },
    "issue_write": { "const": false },
    "fresh_rca": { "type": "boolean", "default": false },
    "max_actions": { "type": "integer", "minimum": 1, "maximum": 1000 }
  }
}
