<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.misty-step.omp-hatchet-reconcile</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HATCHET_ROOT@/scripts/reconcile</string>
    <string>--once</string>
  </array>
  <key>WorkingDirectory</key><string>@HATCHET_ROOT@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>@HOME@</string>
    <key>PATH</key><string>@NODE_BIN_DIR@:@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HATCHET_ROOT</key><string>@HATCHET_ROOT@</string>
    <key>HATCHET_LOCAL_ROOT</key><string>@HATCHET_ROOT@/local</string>
    <key>HATCHET_OPERATOR_CONFIG</key><string>@HATCHET_ROOT@/local/operator-wildcard.json</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>300</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>@HATCHET_ROOT@/local/logs/reconcile.stdout.log</string>
  <key>StandardErrorPath</key><string>@HATCHET_ROOT@/local/logs/reconcile.stderr.log</string>
</dict>
</plist>
