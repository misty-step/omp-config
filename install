#!/bin/sh
set -eu
umask 077

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
agent_dir=${PI_CODING_AGENT_DIR:-$(omp config path)}

command -v jq >/dev/null 2>&1 || { echo "jq is required" >&2; exit 1; }

for source in \
  config.yml \
  models.yml \
  mcp.json \
  global/AGENTS.md \
  global/RULES.md \
  global/WATCHDOG.md \
  global/WATCHDOG.yml
do
  [ -s "$repo_dir/$source" ] || {
    printf 'Missing or empty source: %s\n' "$source" >&2
    exit 1
  }
done

for skill_dir in "$repo_dir"/skills/*; do
  [ -d "$skill_dir" ] || continue
  [ -s "$skill_dir/SKILL.md" ] || {
    printf 'Missing or empty skill entrypoint: %s/SKILL.md\n' "$skill_dir" >&2
    exit 1
  }
done

jq empty "$repo_dir/mcp.json" >/dev/null
if [ -f "$agent_dir/mcp.json" ]; then
  jq empty "$agent_dir/mcp.json" >/dev/null
fi

install -d -m 700 "$agent_dir"
for file in config.yml models.yml; do
  install -m 600 "$repo_dir/$file" "$agent_dir/$file"
done
for file in AGENTS.md RULES.md WATCHDOG.md WATCHDOG.yml; do
  install -m 600 "$repo_dir/global/$file" "$agent_dir/$file"
done

mcp_target="$agent_dir/mcp.json"
if [ -f "$mcp_target" ]; then
  temp=$(mktemp "$agent_dir/.mcp.json.XXXXXX")
  trap 'rm -f "$temp"' 0 1 2 15
  jq -s '
    .[0] as $policy
    | .[1] as $live
    | $policy
    | .mcpServers = (
        $policy.mcpServers
        | with_entries(
            . as $server
            | .value += (
                ($live.mcpServers[$server.key] // {})
                | {auth, oauth}
                | with_entries(select(.value != null))
              )
          )
      )
  ' "$repo_dir/mcp.json" "$mcp_target" > "$temp"
  chmod 600 "$temp"
  mv "$temp" "$mcp_target"
  trap - 0 1 2 15
else
  install -m 600 "$repo_dir/mcp.json" "$mcp_target"
fi

skills_temp=$(mktemp -d "$agent_dir/.skills.XXXXXX")
trap 'rm -rf "$skills_temp"' 0 1 2 15
for skill_dir in "$repo_dir"/skills/*; do
  [ -d "$skill_dir" ] || continue
  skill=${skill_dir##*/}
  skill_target="$skills_temp/$skill"
  install -d -m 700 "$skill_target"
  cp -R "$skill_dir"/. "$skill_target"/
  chmod -R u=rwX,go= "$skill_target"
done
rm -rf -- "$agent_dir/skills"
mv "$skills_temp" "$agent_dir/skills"
trap - 0 1 2 15

printf 'Installed lean OMP config in %s\n' "$agent_dir"
