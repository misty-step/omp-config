def check_model_route_policy(
    settings: Path,
    catalog: Path,
    agent_paths: list[Path],
) -> None:
    """Reject retired Sonnet routes and non-canonical DeepSeek Flash selectors."""
    paths = [settings, catalog, *agent_paths]
    saw_exact_deepseek = False
    for path in paths:
        text = path.read_text()
        sonnet_match = SONNET_5_ROUTE_PATTERN.search(text)
        if sonnet_match:
            fail(f"active Claude Sonnet 5 route in {relative(path)}: {sonnet_match.group(0)!r}")
        for match in DEEPSEEK_ROUTE_PATTERN.finditer(text):
            route = match.group(0)
            if route != EXACT_DEEPSEEK_ROUTE:
                fail(
                    f"{relative(path)} uses non-canonical DeepSeek route {route!r}; "
                    f"expected {EXACT_DEEPSEEK_ROUTE!r}"
                )
            saw_exact_deepseek = True
    if not saw_exact_deepseek:
        fail(f"configuration omits required DeepSeek route {EXACT_DEEPSEEK_ROUTE!r}")

    expected_roles = set(EXPECTED_GLOBAL_MODEL_ROLES)
    actual_roles = set(yaml_mapping_keys(settings, "modelRoles"))
    if actual_roles != expected_roles:
        fail(
            "global model role inventory drift: "
            f"expected={sorted(expected_roles)}, found={sorted(actual_roles)}"
        )
    actual_chain_roles = set(yaml_mapping_keys(settings, "retry.fallbackChains"))
    if actual_chain_roles != expected_roles:
        fail(
            "global fallback role inventory drift: "
            f"expected={sorted(expected_roles)}, found={sorted(actual_chain_roles)}"
        )
    for role, expected_primary in EXPECTED_GLOBAL_MODEL_ROLES.items():
        primary = yaml_setting(settings, f"modelRoles.{role}")
        if primary != expected_primary:
            fail(
                f"model role {role} primary drift: "
                f"expected={expected_primary!r}, found={primary!r}"
            )
        chain = yaml_setting(settings, f"retry.fallbackChains.{role}")
        expected_chain = EXPECTED_GLOBAL_FALLBACK_CHAINS[role]
        if chain != expected_chain:
            fail(
                f"model role {role} fallback drift: "
                f"expected={expected_chain}, found={chain}"
            )



def check_roster_policy(
    contract: Contract,
    settings: Path,
    skill_names: set[str],
    agent_names: set[str],
    agent_fields: dict[str, dict[str, str]],
) -> None:
    """Validate the durable roster, authority envelopes, and native depth ceiling."""
    if agent_names != DURABLE_AGENT_NAMES:
        fail(
            "durable agent roster drift: "
            f"expected={sorted(DURABLE_AGENT_NAMES)}, actual={sorted(agent_names)}"
        )

    for name in sorted(DURABLE_AGENT_NAMES):
        fields = agent_fields[name]
        tools = split_csv(fields.get("tools", ""))
        models = split_csv(fields.get("model", ""))
        if models != EXPECTED_AGENT_MODELS[name]:
            fail(
                f"agent {name} model ladder drift: "
                f"expected={EXPECTED_AGENT_MODELS[name]}, found={models}"
            )
        if tools != EXPECTED_AGENT_TOOLS[name]:
            fail(
                f"agent {name} tool envelope drift: "
                f"expected={EXPECTED_AGENT_TOOLS[name]}, found={tools}"
            )
        if fields.get("thinkingLevel") != EXPECTED_AGENT_THINKING[name]:
            fail(
                f"agent {name} thinking level drift: "
                f"expected={EXPECTED_AGENT_THINKING[name]!r}, found={fields.get('thinkingLevel')!r}"
            )
        skills = split_csv(fields.get("autoloadSkills", ""))
        if skills != EXPECTED_AGENT_SKILLS[name]:
            fail(
                f"agent {name} skill envelope drift: "
                f"expected={EXPECTED_AGENT_SKILLS[name]}, found={skills}"
            )
        if any(skill not in skill_names for skill in skills):
            missing = sorted(skill for skill in skills if skill not in skill_names)
            fail(f"agent {name} autoloads missing or disallowed skills {missing}")

        spawns = split_csv(fields.get("spawns", ""))
        if name == "qa-user":
            expected_spawns = ["qa-user-leaf"]
        else:
            expected_spawns = []
        if spawns != expected_spawns:
            fail(f"agent {name} delegation envelope drift: expected={expected_spawns}, found={spawns}")


    max_depth = yaml_setting(settings, "task.maxRecursionDepth")
    if max_depth != "2":
        fail(f"task.maxRecursionDepth must be 2; found {max_depth!r}")
    max_concurrency = yaml_setting(settings, "task.maxConcurrency")
    if not isinstance(max_concurrency, str) or not max_concurrency.isdigit() or int(max_concurrency) < 1:
        fail(f"task.maxConcurrency must be a positive integer; found {max_concurrency!r}")

    bundled = set(contract.bundled_agents)
    expected_bundled = {"task", "scout", "librarian", "designer", "sonic"}
    if set(contract.bundled_agents) != expected_bundled:
        fail(
            "bundled agent inventory drift: "
            f"expected={sorted(expected_bundled)}, found={sorted(contract.bundled_agents)}"
        )
    disabled_agents = yaml_setting(settings, "task.disabledAgents")
    expected_disabled = ["task", "scout", "librarian", "sonic", "reviewer", "security-reviewer"]
    if disabled_agents != expected_disabled:
        fail(
            "task.disabledAgents must shadow bundled and retired declarations: "
            f"expected={expected_disabled}, found={disabled_agents!r}"
        )

    unexpected_shadows = (bundled & DURABLE_AGENT_NAMES) - {"designer"}
    if unexpected_shadows:
        fail(f"bundled agent inventory shadows durable declarations: {sorted(unexpected_shadows)}")





def check_tree(contract: Contract) -> None:
    settings = contract.surface("settings").source
    context = contract.surface("context").source
    sticky_rules = contract.surface("sticky_rules").source
    mcp_path = contract.surface("mcp").source
    agent_dir = contract.surface("agents").source
    skill_dir = contract.surface("skills").source

    try:
        mcp = json.loads(mcp_path.read_text())
    except json.JSONDecodeError as error:
        fail(f"{relative(mcp_path)} is invalid JSON: {error}")
    servers = mcp.get("mcpServers")
    if not isinstance(servers, dict) or not servers:
        fail(f"{relative(mcp_path)} has no mcpServers")

    sensitive_files = [
        settings,
        mcp_path,
        context,
        sticky_rules,
        *sorted(agent_dir.glob("*.md")),
    ]
    for path in sensitive_files:
        text = path.read_text()
        for label, pattern in SECRET_PATTERNS.items():
            if pattern.search(text):
                fail(f"{label} found in {relative(path)}")

    skill_names = {path.name for path in skill_dir.iterdir() if path.is_dir()}
    builtin_tool_names = omp_builtin_tool_names()
    agent_names: set[str] = set()
    agent_fields: dict[str, dict[str, str]] = {}
    for path in sorted(agent_dir.glob("*.md")):
        try:
            fields, body = frontmatter(path)
        except ContractError as error:
            fail(str(error))
        name = fields.get("name")
        if not name or not fields.get("description") or not body:
            fail(f"{relative(path)} requires name, description, and a prompt body")
        if name != path.stem:
            fail(f"agent {path.name} declares name {name!r}")
        if name in agent_names:
            fail(f"duplicate agent name {name}")
        agent_names.add(name)
        agent_fields[name] = fields
        models = [part.strip() for part in fields.get("model", "").split(",") if part.strip()]
        if not models:
            fail(f"agent {name} requires an explicit model binding")
        for selector in models:
            if "/" not in selector or any(character.isspace() for character in selector):
                fail(f"agent {name} has invalid model selector {selector!r}")
        thinking = fields.get("thinkingLevel")
        if thinking not in THINKING_LEVELS:
            fail(f"agent {name} requires an explicit supported thinkingLevel")
        tools = fields.get("tools")
        if tools is not None:
            explicit_tools = split_csv(tools)
            if not explicit_tools:
                fail(f"agent {name} requires a non-empty explicit tool list or omitted tools")
            for tool in explicit_tools:
                if tool not in builtin_tool_names:
                    fail(f"agent {name} names unknown tool {tool!r}")
        for skill in split_csv(fields.get("autoloadSkills", "")):
            if skill not in skill_names:
                fail(f"agent {name} autoloads missing skill {skill}")

    catalog_path = skill_dir / "dispatch" / "references" / "agent-roster.json"
    try:
        dispatch_catalog = json.loads(catalog_path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        fail(f"{relative(catalog_path)} is invalid: {error}")
    if not isinstance(dispatch_catalog, dict):
        fail(f"{relative(catalog_path)} must be a JSON object")
    if dispatch_catalog.get("schema_version") != "omp.dispatch.agent-roster.v1":
        fail(f"{relative(catalog_path)} has an unsupported schema_version")
    catalog_agents = dispatch_catalog.get("agents")
    if not isinstance(catalog_agents, dict):
        fail(f"{relative(catalog_path)} has no agents object")
    if set(catalog_agents) != agent_names:
        missing = sorted(agent_names - set(catalog_agents))
        extra = sorted(set(catalog_agents) - agent_names)
        fail(f"dispatch agent catalog drift: missing={missing}, extra={extra}")
    for name, fields in agent_fields.items():
        expected = catalog_agents[name]
        actual = {
            "model": split_csv(fields.get("model", "")),
            "thinkingLevel": fields.get("thinkingLevel"),
            "tools": fields.get("tools"),
            "autoloadSkills": split_csv(fields.get("autoloadSkills", "")),
            "spawns": split_csv(fields.get("spawns", "")),
        }
        for key, value in actual.items():
            if expected.get(key) != value:
                fail(
                    f"dispatch agent catalog drift for {name}.{key}: "
                    f"catalog={expected.get(key)!r}, frontmatter={value!r}"
                )
        if not expected.get("when_to_use"):
            fail(f"dispatch agent catalog has no when_to_use for {name}")
    check_roster_policy(
        contract,
        settings,
        skill_names,
        agent_names,
        agent_fields,
    )
    check_model_route_policy(
        settings,
        catalog_path,
        sorted(agent_dir.glob("*.md")),
    )


    allowed_spawns = agent_names | contract.bundled_agents
    for name, fields in agent_fields.items():
        for spawn in split_csv(fields.get("spawns", "")):
            if spawn != "*" and spawn not in allowed_spawns:
                fail(f"agent {name} spawns unknown agent {spawn}")

    check_themes(contract)
    check_presets(contract)

    visible_skills: set[str] = set()
    declared_skills: set[str] = set()
    for directory in sorted(path for path in skill_dir.iterdir() if path.is_dir()):
        skill_file = directory / "SKILL.md"
        if not skill_file.is_file():
            fail(f"skill directory {directory.name} has no SKILL.md")
        try:
            fields, _ = frontmatter(skill_file)
        except ContractError as error:
            fail(str(error))
        name = fields.get("name", directory.name)
        if name != directory.name:
            fail(f"skill directory {directory.name} declares name {name!r}")
        if not fields.get("description"):
            fail(f"skill {name} has no description")
        if fields.get("hide") != "true" and fields.get("disable-model-invocation") != "true":
            visible_skills.add(name)
        if name in declared_skills:
            fail(f"duplicate skill name {name}")
        declared_skills.add(name)
    # The chief core plus universal communication and operator-invoked workflows stay visible.
    expected_visible_skills = {
        "autoreview",
        "dispatch",
        "qa-users",
        "research",
        "simplified-technical-english",
    }
    if visible_skills != expected_visible_skills:
        fail(
            "global visible skill core drift: "
            f"expected={sorted(expected_visible_skills)}, actual={sorted(visible_skills)}"
        )

    routing_path = skill_dir / "dispatch" / "references" / "primitive-routing.md"
    routing_text = routing_path.read_text()
    skill_route_start = "## Skill routes\n"
    skill_route_end = "\n## MCP and tool routes"
    if skill_route_start not in routing_text or skill_route_end not in routing_text:
        fail(f"{relative(routing_path)} has no bounded skill routes table")
    skill_routes = routing_text.split(skill_route_start, 1)[1].split(skill_route_end, 1)[0]
    routed_skills: set[str] = set()
    for line in skill_routes.splitlines():
        if not line.startswith("|") or line.startswith("|---"):
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) < 3 or cells[0] == "Outcome":
            continue
        routed_skills.update(re.findall(r"`([a-z0-9][a-z0-9-]*)`", cells[1]))
    expected_routed_skills = declared_skills - {"dispatch"}
    if routed_skills != expected_routed_skills:
        fail(
            "dispatch skill route drift: "
            f"missing={sorted(expected_routed_skills - routed_skills)}, "
            f"unknown={sorted(routed_skills - expected_routed_skills)}"
        )

    shared_reference_pattern = re.compile(
        r"`(global/references/[A-Za-z0-9._/-]+\.md)`"
    )
    for markdown_path in skill_dir.rglob("*.md"):
        for reference in shared_reference_pattern.findall(markdown_path.read_text()):
            if not (ROOT / reference).is_file():
                fail(
                    f"{relative(markdown_path)} points to missing shared reference "
                    f"{reference}"
                )

def check_qa_users_integrity() -> None:
    try:
        result = subprocess.run(
            ["node", "global/skills/qa-users/scripts/check-integrity.mjs"],
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=30,
        )
    except FileNotFoundError:
        fail("Node executable is not available on PATH")
    except subprocess.TimeoutExpired:
        fail("qa-users integrity validation timed out")
    detail = "\n".join(part for part in (result.stdout.strip(), result.stderr.strip()) if part)
    if result.returncode:
        fail(f"qa-users integrity failed: {detail or 'no output'}")
    if detail:
        print(detail)


def split_csv(value: str) -> list[str]:
    return [part.strip() for part in value.split(",") if part.strip()]


def main(argv: list[str]) -> int:
    if len(argv) > 1 or (argv and argv[0] != "--installed"):
        fail("usage: bin/check [--installed]")
    try:
        contract = load_contract(ROOT)
    except ContractError as error:
        fail(str(error))
    check_tree(contract)
    check_qa_users_integrity()
    check_external_skills(contract)
    check_external_registry_inventory(contract)
    try:
        effective = effective_config(contract)
        check_promptspace_config(contract, effective)
    except ContractError as error:
        fail(str(error))
    if argv:
        try:
            receipts = require_projection(contract)
        except ContractError as error:
            fail(str(error))
        check_extension_cotenancy(contract)
        print(f"OMP source/projection configuration OK ({len(receipts)} symlinks and digests verified)")
    else:
        print("OMP source configuration OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
