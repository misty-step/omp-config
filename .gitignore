# Mutable OMP runtime state never belongs in this repository.
.env
.env.*
local/
# Stage-output URIs written as literal paths leak a dir named `local:`. The
# `local/` rule above does not match it (the trailing path component is the
# colon). Cover both spellings; the colon form also breaks Windows checkouts.
local:/
state/
*.db
*.db-shm
*.db-wal
sessions/
history/
cache/
blobs/
memories/
terminal-sessions/
managed-skills/

# Generated validation artifacts.
.tmp/
dist/
node_modules/
hatchet/fixtures/runs/
.DS_Store
__pycache__/
*.pyc
