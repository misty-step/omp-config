{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://misty-step.dev/schemas/qa-users/tracker.v1.json",
  "title": "qa-users tracker adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selected", "capabilities", "query", "create", "read_back"],
  "properties": {
    "schema_version": { "const": "qa-users.tracker.v1" },
    "selected": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z][a-z0-9._-]{1,63}$" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "create", "read_back"],
      "properties": {
        "query": { "const": true },
        "create": { "const": true },
        "read_back": { "const": true }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "pagination", "truncation_signal"],
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "pagination": { "type": "string", "enum": ["cursor", "page"], "description": "Exhaustive pagination; bounded result modes are invalid." },
        "truncation_signal": { "type": "string", "minLength": 1 }
      }
    },
    "create": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "idempotency_key"],
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "enum": ["finding_fingerprint"] }
      }
    },
    "read_back": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "required_fields"],
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
