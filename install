#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
agent_dir=${PI_CODING_AGENT_DIR:-$(omp config path)}

command -v jq >/dev/null 2>&1 || { echo "jq is required" >&2; exit 1; }

for source in \
  config.yml \
  models.yml \
  AGENTS.md \
  RULES.md \
  mcp.json \
  skills/exa-ai/SKILL.md \
  skills/foundation/SKILL.md \
  skills/herdr/SKILL.md \
  skills/model-research/SKILL.md \
  skills/model-research/references/evidence.md \
  skills/model-research/references/roles.md \
  skills/thermo-nuclear-code-quality-review/SKILL.md
do
  [ -s "$repo_dir/$source" ] || {
    printf 'Missing or empty source: %s\n' "$source" >&2
    exit 1
  }
done

jq empty "$repo_dir/mcp.json" >/dev/null
if [ -f "$agent_dir/mcp.json" ]; then
  jq empty "$agent_dir/mcp.json" >/dev/null
fi

install -d -m 700 "$agent_dir"
for file in config.yml models.yml AGENTS.md RULES.md; do
  install -m 600 "$repo_dir/$file" "$agent_dir/$file"
done

mcp_target="$agent_dir/mcp.json"
if [ -f "$mcp_target" ]; then
  temp=$(mktemp "$agent_dir/.mcp.json.XXXXXX")
  trap 'rm -f "$temp"' 0 1 2 15
  jq -s '
    .[0] as $policy
    | .[1] as $live
    | $policy
    | .mcpServers = (
        $policy.mcpServers
        | with_entries(
            . as $server
            | .value += (
                ($live.mcpServers[$server.key] // {})
                | {auth, oauth}
                | with_entries(select(.value != null))
              )
          )
      )
  ' "$repo_dir/mcp.json" "$mcp_target" > "$temp"
  chmod 600 "$temp"
  mv "$temp" "$mcp_target"
  trap - 0 1 2 15
else
  install -m 600 "$repo_dir/mcp.json" "$mcp_target"
fi

for skill in \
  exa-ai \
  foundation \
  herdr \
  model-research \
  thermo-nuclear-code-quality-review
do
  skill_target="$agent_dir/skills/$skill"
  rm -rf -- "$skill_target"
  install -d -m 700 "$skill_target"
  install -m 600 "$repo_dir/skills/$skill/SKILL.md" "$skill_target/SKILL.md"
done

install -d -m 700 "$agent_dir/skills/model-research/references"
install -m 600 "$repo_dir/skills/model-research/references/"*.md "$agent_dir/skills/model-research/references/"

printf 'Installed lean OMP config in %s\n' "$agent_dir"
