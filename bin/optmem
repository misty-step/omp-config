#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import sys

from optmem_contract import OptMemError, backup, install, update, verify_installation


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="bin/optmem",
        description="administer the pinned external OptMem dependency",
    )
    parser.add_argument("action", choices=("install", "verify", "update", "backup"))
    args = parser.parse_args(argv)
    previous_umask = os.umask(0o077)
    try:
        if args.action == "install":
            result = install()
            print(f"installed OptMem commit {result['commit']} ({result['sha256']})")
            print(f"receipt: {result['receipt']}")
        elif args.action == "verify":
            result = verify_installation()
            records = result["records"]
            print(f"verified OptMem commit {result['commit']} ({result['sha256']})")
            print(f"receipt: {result['receipt']}")
            print(
                "records: "
                f"{records['log_records']} log, "
                f"{records['tree_records']} tree"
            )
        elif args.action == "update":
            result = update()
            print(f"updated OptMem commit {result['commit']} ({result['sha256']})")
            print(f"receipt: {result['receipt']}")
            print(f"backup: {result['backup']}")
        else:
            destination = backup()
            print(f"backup: {destination}")
        return 0
    except OptMemError as error:
        print(f"optmem: {error}", file=sys.stderr)
        return 1
    finally:
        os.umask(previous_umask)

if __name__ == "__main__":
    raise SystemExit(main())
