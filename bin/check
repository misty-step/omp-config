#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

from config_contract import (
    Contract,
    ContractError,
    THINKING_LEVELS,
    effective_config,
    frontmatter,
    load_contract,
    require_projection,
)

ROOT = Path(__file__).resolve().parent.parent
SECRET_PATTERNS = {
    "Firecrawl token": re.compile(r"fc-[A-Za-z0-9_-]{16,}"),
    "OpenAI-style key": re.compile(r"\bsk-[A-Za-z0-9_-]{20,}"),
    "GitHub token": re.compile(r"\b(?:ghp|github_pat)_[A-Za-z0-9_]{20,}"),
}


def fail(message: str) -> None:
    print(f"FAIL: {message}", file=sys.stderr)
    raise SystemExit(1)


def relative(path: Path) -> Path:
    try:
        return path.relative_to(ROOT)
    except ValueError:
        return path


def _yaml_value(raw: str) -> object:
    value = raw.strip()
    if not value:
        return None
    if value == "[]":
        return []
    if (len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}):
        return value[1:-1]
    if value == "true":
        return True
    if value == "false":
        return False
    return value


def yaml_setting(path: Path, dotted: str) -> object:
    wanted = dotted.split(".")
    stack: list[tuple[int, str]] = []
    lines = path.read_text().splitlines()
    for index, line in enumerate(lines):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        indent = len(line) - len(line.lstrip(" "))
        stripped = line.strip()
        if ":" not in stripped:
            continue
        key, raw = stripped.split(":", 1)
        if not key or any(character.isspace() for character in key):
            continue
        while stack and indent <= stack[-1][0]:
            stack.pop()
        current = [entry[1] for entry in stack] + [key]
        if current == wanted:
            parsed = _yaml_value(raw)
            if parsed is not None:
                return parsed
            for following in lines[index + 1 :]:
                if not following.strip() or following.lstrip().startswith("#"):
                    continue
                following_indent = len(following) - len(following.lstrip(" "))
                if following_indent <= indent:
                    break
                return _yaml_value(following.strip())
            return None
        if not raw.strip():
            stack.append((indent, key))
    raise ContractError(f"{relative(path)} omits required setting {dotted}")


def check_promptspace_config(contract: Contract, effective: dict[str, object]) -> None:
    settings = contract.surface("settings").source
    expected = {
        "tui.chrome": "plain",
        "statusLine.preset": "custom",
        "statusLine.leftSegments": [],
        "statusLine.rightSegments": [],
        "theme.dark": "kanagawa",
        "theme.light": "kanagawa-lotus",
    }
    for key, wanted in expected.items():
        actual = yaml_setting(settings, key)
        if actual != wanted:
            fail(f"{relative(settings)} requires {key}={wanted!r}; found {actual!r}")
        entry = effective.get(key)
        if not isinstance(entry, dict) or "value" not in entry:
            if key != "tui.chrome":
                fail(f"OMP effective config omitted required {key}")
            continue
        if entry["value"] != wanted:
            fail(f"OMP effective config changed {key}: expected {wanted!r}, found {entry['value']!r}")
    theme_dir = contract.surface("themes").source
    for key in ("theme.dark", "theme.light"):
        theme_name = expected[key]
        if not (theme_dir / f"{theme_name}.json").is_file():
            fail(f"{relative(theme_dir)} omits active theme {theme_name!r}")


def check_themes(contract: Contract) -> None:
    theme_dir = contract.surface("themes").source
    for path in sorted(theme_dir.glob("*.json")):
        try:
            parsed = json.loads(path.read_text())
        except json.JSONDecodeError as error:
            fail(f"{relative(path)} is invalid JSON: {error}")
        if not isinstance(parsed, dict) or parsed.get("name") != path.stem:
            fail(f"{relative(path)} must have name matching {path.stem!r}")


def parse_preset_filters(path: Path) -> dict[str, list[str]]:
    entries: dict[str, list[str]] = {}
    in_skills = False
    current: str | None = None
    for line_number, line in enumerate(path.read_text().splitlines(), 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        indent = len(line) - len(line.lstrip(" "))
        stripped = line.strip()
        if indent == 0 and stripped == "skills:":
            in_skills = True
            current = None
            continue
        if not in_skills:
            fail(f"{relative(path)} has unsupported YAML at line {line_number}")
        if indent == 2 and stripped.endswith(":"):
            key = stripped[:-1]
            if key not in {"includeSkills", "ignoredSkills"}:
                fail(f"{relative(path)} has unsupported skill filter {key!r}")
            entries[key] = []
            current = key
            continue
        if indent >= 4 and stripped.startswith("- ") and current is not None:
            value = stripped[2:].strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
                value = value[1:-1]
            if not value:
                fail(f"{relative(path)} has an empty skill filter entry at line {line_number}")
            entries[current].append(value)
            continue
        fail(f"{relative(path)} has unsupported YAML at line {line_number}")
    if not entries:
        fail(f"{relative(path)} has no skills.includeSkills or skills.ignoredSkills list")
    return entries


def check_presets(contract: Contract) -> None:
    preset_dir = contract.surface("presets").source
    skill_names = {path.name for path in contract.surface("skills").source.iterdir() if path.is_dir()}
    for path in sorted(preset_dir.glob("*.yml")):
        entries = parse_preset_filters(path)
        env = os.environ.copy()
        env.pop("PI_CONFIG_FILES", None)
        env["PI_CONFIG_FILES"] = str(path.resolve())
        with tempfile.TemporaryDirectory(prefix="omp-config-preset-") as temp:
            temp_root = Path(temp)
            for surface in contract.surfaces:
                target = temp_root / surface.target_rel
                target.parent.mkdir(parents=True, exist_ok=True)
                target.symlink_to(surface.source, target_is_directory=surface.kind == "directory")
            env[contract.projection_env] = str(temp_root)
            try:
                result = subprocess.run(
                    ["omp", "config", "list", "--json"],
                    cwd=ROOT,
                    env=env,
                    text=True,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    timeout=30,
                )
            except FileNotFoundError:
                fail("OMP executable is not available on PATH")
            except subprocess.TimeoutExpired:
                fail(f"preset {relative(path)} OMP validation timed out")
        if result.returncode:
            detail = result.stderr.strip() or result.stdout.strip()
            fail(f"preset {relative(path)} rejected by OMP: {detail}")
        try:
            parsed = json.loads(result.stdout)
        except json.JSONDecodeError as error:
            fail(f"OMP returned invalid config JSON for {relative(path)}: {error}")
        for key, expected in entries.items():
            setting = parsed.get(f"skills.{key}")
            if not isinstance(setting, dict) or setting.get("value") != expected:
                found = setting.get("value") if isinstance(setting, dict) else None
                fail(f"preset {relative(path)} overlay changed skills.{key}: expected {expected!r}, found {found!r}")
            for skill in expected:
                if any(character in skill for character in "*?["):
                    continue
                if skill not in skill_names:
                    fail(f"preset {relative(path)} names missing skill {skill}")


def check_extension_cotenancy(contract: Contract) -> None:
    extension_dir = contract.projection_root / "extensions"
    if not extension_dir.is_dir() or extension_dir.is_symlink():
        fail(f"foreign-writer audit: extensions must be a real directory: {extension_dir}")
    declared = {
        surface.target_rel
        for surface in contract.surfaces
        if surface.kind == "file" and surface.target_rel.parts[:1] == ("extensions",)
    }
    cotenants = {tenant.path_rel for tenant in contract.runtime_cotenants}
    for entry in sorted(extension_dir.iterdir()):
        relative_entry = Path("extensions") / entry.name
        if relative_entry in declared:
            if not entry.is_symlink():
                fail(f"foreign-writer audit: declared extension is not a symlink: {entry}")
            continue
        if relative_entry in cotenants:
            if not entry.is_file() or entry.is_symlink():
                fail(f"foreign-writer audit: cotenant must be a real file: {entry}")
            continue
        fail(f"foreign-writer audit: unexpected extension entry: {entry}")

def omp_builtin_tool_names() -> set[str]:
    try:
        result = subprocess.run(
            ["omp", "--help"],
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=30,
        )
    except FileNotFoundError:
        fail("OMP executable is not available on PATH")
    except subprocess.TimeoutExpired:
        fail("OMP tool authority lookup timed out")
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip()
        fail(f"OMP tool authority lookup failed: {detail}")
    marker = "Available Tools"
    if marker not in result.stdout:
        fail("OMP help omitted its built-in tool authority")
    authority = result.stdout.split(marker, 1)[1]
    names = {
        match.group(1)
        for line in authority.splitlines()
        if (match := re.match(r"\s{2}([A-Za-z][A-Za-z0-9_-]*)\s+-\s+", line))
    }
    if not names:
        fail("OMP help exposed an empty built-in tool authority")
    return names


def check_tree(contract: Contract) -> None:
    settings = contract.surface("settings").source
    context = contract.surface("context").source
    sticky_rules = contract.surface("sticky_rules").source
    mcp_path = contract.surface("mcp").source
    agent_dir = contract.surface("agents").source
    skill_dir = contract.surface("skills").source

    try:
        mcp = json.loads(mcp_path.read_text())
    except json.JSONDecodeError as error:
        fail(f"{relative(mcp_path)} is invalid JSON: {error}")
    servers = mcp.get("mcpServers")
    if not isinstance(servers, dict) or not servers:
        fail(f"{relative(mcp_path)} has no mcpServers")

    sensitive_files = [
        settings,
        mcp_path,
        context,
        sticky_rules,
        *sorted(agent_dir.glob("*.md")),
    ]
    for path in sensitive_files:
        text = path.read_text()
        for label, pattern in SECRET_PATTERNS.items():
            if pattern.search(text):
                fail(f"{label} found in {relative(path)}")

    skill_names = {path.name for path in skill_dir.iterdir() if path.is_dir()}
    builtin_tool_names = omp_builtin_tool_names()
    agent_names: set[str] = set()
    agent_fields: dict[str, dict[str, str]] = {}
    for path in sorted(agent_dir.glob("*.md")):
        try:
            fields, body = frontmatter(path)
        except ContractError as error:
            fail(str(error))
        name = fields.get("name")
        if not name or not fields.get("description") or not body:
            fail(f"{relative(path)} requires name, description, and a prompt body")
        if name != path.stem:
            fail(f"agent {path.name} declares name {name!r}")
        if name in agent_names:
            fail(f"duplicate agent name {name}")
        agent_names.add(name)
        agent_fields[name] = fields
        models = [part.strip() for part in fields.get("model", "").split(",") if part.strip()]
        if not models:
            fail(f"agent {name} requires an explicit model binding")
        for selector in models:
            if "/" not in selector or any(character.isspace() for character in selector):
                fail(f"agent {name} has invalid model selector {selector!r}")
        thinking = fields.get("thinkingLevel")
        if thinking not in THINKING_LEVELS:
            fail(f"agent {name} requires an explicit supported thinkingLevel")
        tools = fields.get("tools")
        if tools is not None:
            explicit_tools = split_csv(tools)
            if not explicit_tools:
                fail(f"agent {name} requires a non-empty explicit tool list or omitted tools")
            for tool in explicit_tools:
                if tool not in builtin_tool_names:
                    fail(f"agent {name} names unknown tool {tool!r}")
        for skill in split_csv(fields.get("autoloadSkills", "")):
            if skill not in skill_names:
                fail(f"agent {name} autoloads missing skill {skill}")

    catalog_path = skill_dir / "dispatch" / "references" / "agent-compositions.json"
    try:
        dispatch_catalog = json.loads(catalog_path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        fail(f"{relative(catalog_path)} is invalid: {error}")
    if not isinstance(dispatch_catalog, dict):
        fail(f"{relative(catalog_path)} must be a JSON object")
    if dispatch_catalog.get("schema_version") != "omp.dispatch.agent-compositions.v1":
        fail(f"{relative(catalog_path)} has an unsupported schema_version")
    catalog_agents = dispatch_catalog.get("agents")
    if not isinstance(catalog_agents, dict):
        fail(f"{relative(catalog_path)} has no agents object")
    if set(catalog_agents) != agent_names:
        missing = sorted(agent_names - set(catalog_agents))
        extra = sorted(set(catalog_agents) - agent_names)
        fail(f"dispatch agent catalog drift: missing={missing}, extra={extra}")
    for name, fields in agent_fields.items():
        expected = catalog_agents[name]
        actual = {
            "model": split_csv(fields.get("model", "")),
            "thinkingLevel": fields.get("thinkingLevel"),
            "tools": fields.get("tools"),
            "autoloadSkills": split_csv(fields.get("autoloadSkills", "")),
            "spawns": split_csv(fields.get("spawns", "")),
        }
        for key, value in actual.items():
            if expected.get(key) != value:
                fail(
                    f"dispatch agent catalog drift for {name}.{key}: "
                    f"catalog={expected.get(key)!r}, frontmatter={value!r}"
                )
        if not expected.get("when_to_use"):
            fail(f"dispatch agent catalog has no when_to_use for {name}")

    allowed_spawns = agent_names | contract.bundled_agents
    for name, fields in agent_fields.items():
        for spawn in split_csv(fields.get("spawns", "")):
            if spawn != "*" and spawn not in allowed_spawns:
                fail(f"agent {name} spawns unknown agent {spawn}")

    check_themes(contract)
    check_presets(contract)

    visible_skills: set[str] = set()
    declared_skills: set[str] = set()
    for directory in sorted(path for path in skill_dir.iterdir() if path.is_dir()):
        skill_file = directory / "SKILL.md"
        if not skill_file.is_file():
            fail(f"skill directory {directory.name} has no SKILL.md")
        try:
            fields, _ = frontmatter(skill_file)
        except ContractError as error:
            fail(str(error))
        name = fields.get("name", directory.name)
        if name != directory.name:
            fail(f"skill directory {directory.name} declares name {name!r}")
        if not fields.get("description"):
            fail(f"skill {name} has no description")
        if fields.get("hide") != "true" and fields.get("disable-model-invocation") != "true":
            visible_skills.add(name)
        if name in declared_skills:
            fail(f"duplicate skill name {name}")
        declared_skills.add(name)
    expected_visible_skills = {"dispatch", "research"}
    if visible_skills != expected_visible_skills:
        fail(
            "global visible skill core drift: "
            f"expected={sorted(expected_visible_skills)}, actual={sorted(visible_skills)}"
        )

    routing_path = skill_dir / "dispatch" / "references" / "primitive-routing.md"
    routing_text = routing_path.read_text()
    skill_route_start = "## Skill routes\n"
    skill_route_end = "\n## MCP and tool routes"
    if skill_route_start not in routing_text or skill_route_end not in routing_text:
        fail(f"{relative(routing_path)} has no bounded skill routes table")
    skill_routes = routing_text.split(skill_route_start, 1)[1].split(skill_route_end, 1)[0]
    routed_skills: set[str] = set()
    for line in skill_routes.splitlines():
        if not line.startswith("|") or line.startswith("|---"):
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) < 3 or cells[0] == "Outcome":
            continue
        routed_skills.update(re.findall(r"`([a-z0-9][a-z0-9-]*)`", cells[1]))
    expected_routed_skills = declared_skills - {"dispatch"}
    if routed_skills != expected_routed_skills:
        fail(
            "dispatch skill route drift: "
            f"missing={sorted(expected_routed_skills - routed_skills)}, "
            f"unknown={sorted(routed_skills - expected_routed_skills)}"
        )

    shared_reference_pattern = re.compile(
        r"`(global/references/[A-Za-z0-9._/-]+\.md)`"
    )
    for markdown_path in skill_dir.rglob("*.md"):
        for reference in shared_reference_pattern.findall(markdown_path.read_text()):
            if not (ROOT / reference).is_file():
                fail(
                    f"{relative(markdown_path)} points to missing shared reference "
                    f"{reference}"
                )

    check_external_registry()


def _registry_unquote(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
        return value[1:-1]
    return value


def _registry_flow_list(raw: str) -> list[str]:
    inner = raw.strip()
    if inner.startswith("[") and inner.endswith("]"):
        inner = inner[1:-1]
    if not inner.strip():
        return []
    return [_registry_unquote(part) for part in inner.split(",") if part.strip()]


def _registry_field_value(raw: str) -> object:
    value = raw.strip()
    if not value:
        return None
    if value.startswith("["):
        return _registry_flow_list(value)
    if value == "true":
        return True
    if value == "false":
        return False
    return _registry_unquote(value)


def parse_registry_sources(path: Path) -> list[dict[str, object]]:
    """Parse the `sources:` list from registry.yaml without a YAML dependency.

    registry.yaml is a hand-edited ledger; this parser understands only the
    shape it actually uses (a top-level ``sources:`` mapping of list items,
    each a flat dict whose only nested value is an inline ``include: [...]``
    flow sequence). It deliberately raises on anything else so a schema drift
    in the registry surfaces here rather than silently passing the gate.
    """
    sources: list[dict[str, object]] = []
    in_sources = False
    current: dict[str, object] | None = None
    item_indent = -1
    for line in path.read_text().splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        indent = len(line) - len(line.lstrip(" "))
        stripped = line.strip()
        if not in_sources:
            if indent == 0 and stripped == "sources:":
                in_sources = True
            continue
        if indent == 0:
            break
        if stripped.startswith("- "):
            if current is not None:
                sources.append(current)
            current = {}
            item_indent = indent
            rest = stripped[2:].strip()
            if ":" in rest:
                key, raw = rest.split(":", 1)
                current[key.strip()] = _registry_field_value(raw)
            else:
                fail(f"{relative(path)} has an unparseable source entry: {stripped!r}")
        elif current is not None and indent > item_indent and ":" in stripped:
            key, raw = stripped.split(":", 1)
            current[key.strip()] = _registry_field_value(raw)
    if current is not None:
        sources.append(current)
    return sources


def check_external_registry() -> None:
    """Assert registry.yaml pins and global/external/ directories stay 1:1.

    Every non-default source must declare alias_prefix plus either skill_name
    or include, which together name the vendored directory(ies) it owns. The
    gate rejects drift in both directions: a pinned source whose directory was
    deleted (missing_dirs) and a vendored directory with no pin (unpinned_dirs).
    Consumer presence (AC1: "a pin without a consumer is rot") is a human-review
    invariant documented per-pin in registry.yaml comments, not enforced here.
    """
    registry = ROOT / "global" / "external" / "registry.yaml"
    if not registry.is_file():
        fail(f"{relative(registry)} is missing")
    external_dir = registry.parent
    expected: set[str] = set()
    for source in parse_registry_sources(registry):
        if source.get("default") is True:
            continue
        repo = source.get("repo")
        prefix = source.get("alias_prefix")
        if not isinstance(prefix, str) or not prefix:
            fail(f"{relative(registry)} source {repo!r} lacks required alias_prefix")
        skill_name = source.get("skill_name")
        include = source.get("include")
        if isinstance(skill_name, str) and skill_name:
            expected.add(prefix + skill_name)
        elif isinstance(include, list) and include:
            for name in include:
                if not isinstance(name, str) or not name:
                    fail(f"{relative(registry)} source {repo!r} has an empty include entry")
                expected.add(prefix + name)
        else:
            fail(
                f"{relative(registry)} source {repo!r} must declare skill_name or "
                f"include so its vendored directory is discoverable"
            )
    actual = {
        entry.name
        for entry in external_dir.iterdir()
        if entry.is_dir() and not entry.is_symlink()
    }
    missing = sorted(expected - actual)
    extra = sorted(actual - expected)
    if missing or extra:
        fail(
            f"{relative(registry)} drifts from {relative(external_dir)}: "
            f"missing_dirs={missing}, unpinned_dirs={extra}"
        )


def split_csv(value: str) -> list[str]:
    return [part.strip() for part in value.split(",") if part.strip()]


def main(argv: list[str]) -> int:
    if len(argv) > 1 or (argv and argv[0] != "--installed"):
        fail("usage: bin/check [--installed]")
    try:
        contract = load_contract(ROOT)
    except ContractError as error:
        fail(str(error))
    check_tree(contract)
    try:
        effective = effective_config(contract)
        check_promptspace_config(contract, effective)
    except ContractError as error:
        fail(str(error))
    if argv:
        try:
            receipts = require_projection(contract)
        except ContractError as error:
            fail(str(error))
        check_extension_cotenancy(contract)
        print(f"OMP source/projection configuration OK ({len(receipts)} symlinks and digests verified)")
    else:
        print("OMP source configuration OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
