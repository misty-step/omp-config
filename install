#!/bin/sh
set -eu
umask 077

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
agent_dir=${PI_CODING_AGENT_DIR:-$(omp config path)}

command -v jq >/dev/null 2>&1 || { echo "jq is required" >&2; exit 1; }
command -v bun >/dev/null 2>&1 || { echo "bun is required" >&2; exit 1; }

for source in \
  config.yml \
  models.yml \
  mcp.json \
  global/AGENTS.md \
  global/RULES.md \
  global/WATCHDOG.md \
  global/WATCHDOG.yml \
  bin/omp-grievances.ts \
  themes/tokyonight.json \
  themes/everforest.json \
  themes/everforest-light.json
do
  [ -s "$repo_dir/$source" ] || {
    printf 'Missing or empty source: %s\n' "$source" >&2
    exit 1
  }
done

for skill_dir in "$repo_dir"/skills/*; do
  [ -d "$skill_dir" ] || continue
  [ -s "$skill_dir/SKILL.md" ] || {
    printf 'Missing or empty skill entrypoint: %s/SKILL.md\n' "$skill_dir" >&2
    exit 1
  }
done

for agent_file in "$repo_dir"/agents/*.md; do
  [ -s "$agent_file" ] || {
    printf 'Missing or empty agent definition: %s\n' "$agent_file" >&2
    exit 1
  }
done


jq empty "$repo_dir/mcp.json" >/dev/null
for theme_file in "$repo_dir"/themes/*.json; do
  [ -s "$theme_file" ] || continue
  jq empty "$theme_file" >/dev/null
done
if [ -f "$agent_dir/mcp.json" ]; then
  jq empty "$agent_dir/mcp.json" >/dev/null
fi

install -d -m 700 "$agent_dir"
for file in config.yml models.yml; do
  install -m 600 "$repo_dir/$file" "$agent_dir/$file"
done
install -d -m 700 "$agent_dir/themes"
rm -f -- "$agent_dir/themes/ember.json" "$agent_dir/themes/ember-dawn.json"
for theme_file in "$repo_dir"/themes/*.json; do
  [ -s "$theme_file" ] || continue
  install -m 600 "$theme_file" "$agent_dir/themes/${theme_file##*/}"
done
for file in AGENTS.md RULES.md WATCHDOG.md WATCHDOG.yml; do
  install -m 600 "$repo_dir/global/$file" "$agent_dir/$file"
done

agents_temp=$(mktemp -d "$agent_dir/.agents.XXXXXX")
trap 'rm -rf "$agents_temp"' 0 1 2 15
for agent_file in "$repo_dir"/agents/*.md; do
  [ -s "$agent_file" ] || continue
  install -m 600 "$agent_file" "$agents_temp/${agent_file##*/}"
done
rm -rf -- "$agent_dir/agents"
mv "$agents_temp" "$agent_dir/agents"
trap - 0 1 2 15

rm -rf -- "$agent_dir/references/review"

mcp_target="$agent_dir/mcp.json"
if [ -f "$mcp_target" ]; then
  temp=$(mktemp "$agent_dir/.mcp.json.XXXXXX")
  trap 'rm -f "$temp"' 0 1 2 15
  jq -s '
    .[0] as $policy
    | .[1] as $live
    | $policy
    | .mcpServers = (
        $policy.mcpServers
        | with_entries(
            . as $server
            | .value += (
                ($live.mcpServers[$server.key] // {})
                | {auth, oauth}
                | with_entries(select(.value != null))
              )
          )
      )
  ' "$repo_dir/mcp.json" "$mcp_target" > "$temp"
  chmod 600 "$temp"
  mv "$temp" "$mcp_target"
  trap - 0 1 2 15
else
  install -m 600 "$repo_dir/mcp.json" "$mcp_target"
fi

skills_temp=$(mktemp -d "$agent_dir/.skills.XXXXXX")
trap 'rm -rf "$skills_temp"' 0 1 2 15
for skill_dir in "$repo_dir"/skills/*; do
  [ -d "$skill_dir" ] || continue
  skill=${skill_dir##*/}
  skill_target="$skills_temp/$skill"
  install -d -m 700 "$skill_target"
  cp -R "$skill_dir"/. "$skill_target"/
  chmod -R u=rwX,go= "$skill_target"
done
rm -rf -- "$agent_dir/skills"
mv "$skills_temp" "$agent_dir/skills"
trap - 0 1 2 15

hook_src="$repo_dir/.githooks/pre-push"
if [ -s "$hook_src" ]; then
  git_dir=$(git -C "$repo_dir" rev-parse --absolute-git-dir 2>/dev/null) || git_dir=
  if [ -n "$git_dir" ]; then
    install -d "$git_dir/hooks"
    install -m 700 "$hook_src" "$git_dir/hooks/pre-push"
  fi
fi
rm -f "$agent_dir/extensions/evidence-packet.ts"

if [ -d "$repo_dir/extensions/loc" ]; then
  install -d -m 700 "$agent_dir/extensions/loc"
  for ext_entry in "$repo_dir"/extensions/loc/*; do
    [ -f "$ext_entry" ] || continue
    install -m 700 "$ext_entry" "$agent_dir/extensions/loc/${ext_entry##*/}"
  done
fi

loc_hook="$repo_dir/extensions/loc/git-hook.sh"
if [ -x "$loc_hook" ]; then
  git_dir=$(git -C "$repo_dir" rev-parse --absolute-git-dir 2>/dev/null) || git_dir=
  if [ -n "$git_dir" ]; then
    install -d "$git_dir/hooks"
    for hook_name in post-commit post-merge post-checkout; do
      target="$git_dir/hooks/$hook_name"
      if [ ! -e "$target" ]; then
        ln -sf "../../extensions/loc/git-hook.sh" "$target" 2>/dev/null || install -m 700 "$loc_hook" "$target"
      fi
    done
  fi
fi

install -d -m 700 "$HOME/.local/bin"
install -m 700 "$repo_dir/bin/omp-grievances.ts" "$HOME/.local/bin/omp-grievances"

printf 'Installed lean OMP config in %s\n' "$agent_dir"
