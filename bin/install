#!/usr/bin/env python3
from __future__ import annotations

import os
import shutil
import sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
GLOBAL = ROOT / "global"
AGENT_DIR = Path(os.environ.get("PI_CODING_AGENT_DIR", Path.home() / ".omp" / "agent"))
ASSETS = ("config.yml", "AGENTS.md", "RULES.md", "mcp.json", "agents", "skills")
FORBIDDEN = {
    "agent.db",
    "models.db",
    "history.db",
    "sessions",
    "cache",
    "blobs",
    "memories",
    "terminal-sessions",
    "managed-skills",
    "extensions",
}


def die(message: str) -> None:
    print(f"install: {message}", file=sys.stderr)
    raise SystemExit(1)


AGENT_DIR.mkdir(parents=True, exist_ok=True)
if any(name in ASSETS for name in FORBIDDEN):
    die("internal boundary error: mutable state selected for linking")

stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
backup = AGENT_DIR / "backups" / f"omp-config-{stamp}"
backed_up = False

for name in ASSETS:
    source = GLOBAL / name
    target = AGENT_DIR / name
    if not source.exists():
        die(f"missing source {source}")
    if target.is_symlink() and target.resolve() == source.resolve():
        print(f"keep {target} -> {source}")
        continue
    if target.exists() or target.is_symlink():
        backup.mkdir(parents=True, exist_ok=True)
        destination = backup / name
        if destination.exists() or destination.is_symlink():
            die(f"backup collision at {destination}")
        shutil.move(str(target), str(destination))
        backed_up = True
        print(f"backup {target} -> {destination}")
    target.symlink_to(source, target_is_directory=source.is_dir())
    print(f"link {target} -> {source}")

local_env = AGENT_DIR / ".env"
if local_env.exists():
    os.chmod(local_env, 0o600)

if backed_up:
    print(f"backup root: {backup}")
print("OMP declarative configuration installed; mutable runtime state untouched")
